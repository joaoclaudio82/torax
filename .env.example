# Origins autorizadas (separadas por vírgula)
THORAX_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Upload e proteção contra abuso
THORAX_MAX_UPLOAD_MB=15
THORAX_RATE_LIMIT_MAX=30
THORAX_RATE_LIMIT_WINDOW=60
THORAX_TRUST_PROXY=0
THORAX_REQUEST_ID_MAX_LENGTH=128

# Cache e jobs em memória
THORAX_CACHE_MAX_ENTRIES=32
THORAX_CACHE_TTL_SECONDS=1800
THORAX_JOB_MAX=64
THORAX_JOB_TTL_SECONDS=1800

# Observabilidade
THORAX_METRICS_ENABLED=1

# Deixe vazio em desenvolvimento; use segredo forte fora do ambiente local.
THORAX_ADMIN_TOKEN=
